# Base URL of the companion Admin Starter API (no trailing slash).
VITE_APP_API_URL=http://localhost:3000

# Public URL of this admin app (optional; validated in src/config/env.ts).
# VITE_APP_APP_URL=http://localhost:4200

# MSW mock worker port when API mocking is enabled (optional, default 8080).
# VITE_APP_MOCK_API_PORT=8080

# API mocking (MSW) when the backend is unavailable.
VITE_APP_ENABLE_API_MOCKING=true

# Application base path for deployment (read by vite.config.ts).
BASE_URL=/
