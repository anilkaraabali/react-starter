import { useMutation, useQueryClient } from '@tanstack/react-query';
import { {{keysFactory}} } from '@/api/endpoints/{{pluralKebab}}/{{pluralKebab}}.keys';
import { api } from '@/lib/api-client';
import type { MutationConfig } from '@/lib/react-query';

const delete{{entityPascal}} = (id: string) => {
  return api.delete<never, void>(`{{apiPath}}/${id}`);
};

type UseDelete{{entityPascal}}Options = {
  mutationConfig?: MutationConfig<typeof delete{{entityPascal}}>;
};

export const useDelete{{entityPascal}} = ({
  mutationConfig,
}: UseDelete{{entityPascal}}Options = {}) => {
  const queryClient = useQueryClient();

  const { onSuccess, ...restConfig } = mutationConfig || {};

  return useMutation({
    mutationFn: delete{{entityPascal}},
    onSuccess: (...args) => {
      void queryClient.invalidateQueries({
        queryKey: {{keysFactory}}.lists(),
      });
      onSuccess?.(...args);
    },
    ...restConfig,
  });
};
