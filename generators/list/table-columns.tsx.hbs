import { msg } from '@lingui/core/macro';
import { Link } from '@tanstack/react-router';
import { EyeIcon, PencilLineIcon, Trash2Icon } from 'lucide-react';
import type { {{entityPascal}}Dto } from '@/api/models/{{pluralKebab}}/{{entityKebab}}-dto';
import type { TableColumnDef } from '@/components/organisms/data-table/data-table.types';
import { TableAction } from '@/components/organisms/data-table/table-action';
import { {{entityPascal}}StatusChip } from '@/features/{{featureDir}}/components/{{entityKebab}}-status-chip';
import type { Translate } from '@/types/i18n.types';

export function create{{pluralPascal}}TableColumns(
  t: Translate,
  onDeleteClick: ({{entityCamel}}: {{entityPascal}}Dto) => void
): readonly TableColumnDef<{{entityPascal}}Dto>[] {
  return [
    {
      cell: (row) => (
        <Link
          className='hover:underline'
          params={
            {
              {{routeParam}}: row.id,
            }
          }
          to='{{routePath}}/${{routeParam}}'
        >
          {row.name}
        </Link>
      ),
      header: () => t(msg`Name`),
      id: 'name',
      isRowHeader: true,
    },
    {
      cell: (row) => <{{entityPascal}}StatusChip status={row.status} />,
      header: () => t(msg`Status`),
      id: 'status',
    },
    {
      cell: (row) => (
        <div className='flex items-center justify-end gap-1'>
          <TableAction.Link
            label={t(msg`View details`)}
            params={
              {
                {{routeParam}}: row.id,
              }
            }
            to='{{routePath}}/${{routeParam}}'
          >
            <EyeIcon />
          </TableAction.Link>
          <TableAction.Link
            label={t(msg`Edit {{entityKebab}}`)}
            params={
              {
                {{routeParam}}: row.id,
              }
            }
            to='{{routePath}}/${{routeParam}}/edit'
          >
            <PencilLineIcon />
          </TableAction.Link>
          <TableAction.Button
            label={t(msg`Delete {{entityKebab}}`)}
            onPress={() => onDeleteClick(row)}
            variant='danger-soft'
          >
            <Trash2Icon className='text-danger' />
          </TableAction.Button>
        </div>
      ),
      header: () => '',
      hideable: true,
      id: 'actions',
      label: () => t(msg`Actions`),
    },
  ];
}
