import { msg } from '@lingui/core/macro';
import { useLingui } from '@lingui/react/macro';
import { createFileRoute } from '@tanstack/react-router';
import { BackButton } from '@/components/atoms/back-button';
import { ContentLayout } from '@/components/templates/content-layout';
import { Create{{entityPascal}} } from '@/features/{{featureDir}}/components/forms/create-{{entityKebab}}';
import type { MetaFunction } from '@/types/meta.types';

const meta: MetaFunction = (i18n) => [
  {
    title: i18n._(msg`Create {{singularTitle}}`),
  },
];

function {{entityPascal}}CreatePage() {
  const { t } = useLingui();

  return (
    <ContentLayout
      actions={<BackButton to='{{routePath}}'>{t`Back to {{pluralTitle}}`}</BackButton>}
      description={t`Add a new {{entityKebab}} to your workspace.`}
    >
      <Create{{entityPascal}} />
    </ContentLayout>
  );
}

export const Route = createFileRoute('/_admin/{{featureDir}}/new')({
  component: {{entityPascal}}CreatePage,
  loader: () => ({ meta }),
});
