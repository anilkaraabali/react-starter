import { msg } from '@lingui/core/macro';
import { createFileRoute } from '@tanstack/react-router';
import { get{{entityPascal}}QueryOptions } from '@/features/{{featureDir}}/api/get-{{entityKebab}}';
import { Edit{{entityPascal}}View } from '@/features/{{featureDir}}/components/forms/edit-{{entityKebab}}-view';
import type { MetaFunction } from '@/types/meta.types';

const meta: MetaFunction = (i18n) => [
  {
    title: i18n._(msg`Edit {{singularTitle}}`),
  },
];

export const Route = createFileRoute('/_admin/{{featureDir}}/${{routeParam}}/edit')({
  component: Edit{{entityPascal}}RouteComponent,
  loader: ({ context: { queryClient }, params }) => {
    void queryClient.query({
      ...get{{entityPascal}}QueryOptions(params.{{routeParam}}),
      staleTime: 'static',
    });
    return { meta };
  },
});

function Edit{{entityPascal}}RouteComponent() {
  const { {{routeParam}} } = Route.useParams();
  return <Edit{{entityPascal}}View {{routeParam}}={ {{routeParam}} } />;
}
