import { msg } from '@lingui/core/macro';
import { useLingui } from '@lingui/react/macro';
import { createFileRoute, useNavigate } from '@tanstack/react-router';
import { useState } from 'react';
import { get{{entityPascal}}QueryOptions } from '@/api/endpoints/{{pluralKebab}}/get-{{entityKebab}}';
import { useDynamicHead } from '@/lib/head/head-provider';
import { BackButton } from '@/components/atoms/back-button';
import { FormActions } from '@/components/organisms/form/actions/form-actions';
import { ContentLayout } from '@/components/templates/content-layout';
import { Delete{{entityPascal}}Modal } from '@/features/{{featureDir}}/components/delete-{{entityKebab}}-modal';
import { Edit{{entityPascal}} } from '@/features/{{featureDir}}/components/forms/edit-{{entityKebab}}';
import { {{entityPascal}}QueryBoundary } from '@/features/{{featureDir}}/components/{{entityKebab}}-query-boundary';

function {{entityPascal}}DynamicHead({ name }: { name: string }) {
  useDynamicHead({ title: name });
  return null;
}

function {{entityPascal}}EditPage() {
  const { {{routeParam}} } = Route.useParams();
  const { t } = useLingui();
  const navigate = useNavigate();
  const [isDeleteOpen, setIsDeleteOpen] = useState(false);

  return (
    <{{entityPascal}}QueryBoundary {{routeParam}}={ {{routeParam}} }>
      {({{entityCamel}}) => (
        <>
          <{{entityPascal}}DynamicHead name={ {{entityCamel}}.name } />
          <ContentLayout
            actions={
              <>
                <BackButton to='{{routePath}}'>{t`Back to {{pluralTitle}}`}</BackButton>
                <FormActions
                  deleteLabel={t`Delete {{entityKebab}}`}
                  onDelete={() => setIsDeleteOpen(true)}
                />
              </>
            }
          >
            <Edit{{entityPascal}} {{entityCamel}}={ {{entityCamel}} } {{routeParam}}={ {{routeParam}} } />
          </ContentLayout>
          <Delete{{entityPascal}}Modal
            isOpen={isDeleteOpen}
            onClose={() => setIsDeleteOpen(false)}
            onSuccess={() => {
              void navigate({ to: '{{routePath}}' });
            }}
            {{entityCamel}}={ {{entityCamel}} }
          />
        </>
      )}
    </{{entityPascal}}QueryBoundary>
  );
}

export const Route = createFileRoute('/_admin/{{featureDir}}/${{routeParam}}/edit')({
  component: {{entityPascal}}EditPage,
  loader: ({ context: { queryClient }, params }) => {
    void queryClient.query({
      ...get{{entityPascal}}QueryOptions(params.{{routeParam}}),
      staleTime: 'static',
    });
  },
  staticData: { title: msg`Edit {{singularTitle}}` },
});
