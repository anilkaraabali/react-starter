import { msg } from '@lingui/core/macro';
import { createFileRoute } from '@tanstack/react-router';
import { get{{entityPascal}}QueryOptions } from '@/features/{{featureDir}}/api/get-{{entityKebab}}';
import { {{entityPascal}}DetailView } from '@/features/{{featureDir}}/components/{{entityKebab}}-details/{{entityKebab}}-detail-view';
import type { MetaFunction } from '@/types/meta.types';

const meta: MetaFunction = (i18n) => [
  {
    title: i18n._(msg`{{singularTitle}} Details`),
  },
];

export const Route = createFileRoute('/_admin/{{featureDir}}/${{routeParam}}/')({
  component: {{entityPascal}}DetailRouteComponent,
  loader: ({ context: { queryClient }, params }) => {
    void queryClient.query({
      ...get{{entityPascal}}QueryOptions(params.{{routeParam}}),
      staleTime: 'static',
    });
    return { meta };
  },
});

function {{entityPascal}}DetailRouteComponent() {
  const { {{routeParam}} } = Route.useParams();
  return <{{entityPascal}}DetailView {{routeParam}}={ {{routeParam}} } />;
}
