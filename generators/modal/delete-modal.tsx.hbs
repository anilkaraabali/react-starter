import { toast } from '@heroui/react';
import { useLingui } from '@lingui/react/macro';
import { Trans } from '@lingui/react/macro';
import { ConfirmDialog } from '@/components/molecules/confirm-dialog';
import { useDelete{{entityPascal}} } from '@/features/{{featureDir}}/api/delete-{{entityKebab}}';
import type { {{entityPascal}} } from '@/features/{{featureDir}}/types/{{entityKebab}}.types';

type Delete{{entityPascal}}ModalProps = {
  isOpen: boolean;
  onClose: () => void;
  onSuccess?: () => void;
  {{entityCamel}}: {{entityPascal}} | null;
};

export function Delete{{entityPascal}}Modal({
  isOpen,
  onClose,
  onSuccess,
  {{entityCamel}},
}: Delete{{entityPascal}}ModalProps) {
  const { t } = useLingui();
  const delete{{entityPascal}}Mutation = useDelete{{entityPascal}}({
    mutationConfig: {
      onSuccess: () => {
        toast.success(t`{{singularTitle}} deleted.`);
        onClose();
        onSuccess?.();
      },
    },
  });

  if (!{{entityCamel}}) return null;

  return (
    <ConfirmDialog
      confirmLabel={t`Delete`}
      isOpen={isOpen}
      isPending={delete{{entityPascal}}Mutation.isPending}
      onClose={onClose}
      onConfirm={() => delete{{entityPascal}}Mutation.mutateAsync({{entityCamel}}.id)}
      title={t`Delete {{singularTitle}}`}
    >
      <Trans>
        Are you sure you want to delete <b>{{entityCamel}}.name</b>? This action
        cannot be undone.
      </Trans>
    </ConfirmDialog>
  );
}
