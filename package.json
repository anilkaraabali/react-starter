    "@internationalized/date": "^3.12.3",
    "@lingui/core": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router": "^1.114.23",
    "@tanstack/react-router-devtools": "^1.162.4",
    "@tanstack/zod-adapter": "^1.167.0",
    "axios": "^1.19.0",
    "better-auth": "1.6.23",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.38.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.33.0",
    "nprogress": "^0.2.0",
    "react": "^19.0.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.5"
  },
  "description": "Admin Starter — React Admin Template (React, Vite, HeroUI v3, TanStack)",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@lingui/cli": "^6.9.0",
    "@lingui/conf": "^6.9.0",
    "@lingui/format-po": "^6.9.0",
    "@lingui/vite-plugin": "^6.9.0",
    "@react-dev-inspector/babel-plugin": "^2.0.1",
    "@react-dev-inspector/vite-plugin": "2.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/router-plugin": "^1.114.23",
    "@testing-library/react": "^16.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.15.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "ico-endec": "^0.1.6",
    "jscpd": "^5.3.2",
    "jsdom": "^30.1.2",
    "knip": "^6.38.0",
    "lint-staged": "^16.4.0",
    "msw": "^3.0.3",
    "oxc-transform-react": "^0.153.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=9.12.0"
  },
  "name": "admin-starter",
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "@better-auth/drizzle-adapter": "1.6.23",
      "better-auth": "1.6.23",
      "kysely": "0.29.3",
      "seroval": "1.6.8",
      "seroval-plugins": "1.6.8"
    }
  },
  "private": true,
  "scripts": {
    "agents:heroui": "pnpm dlx heroui-cli@latest agents-md --react --output AGENTS.md",
    "build": "pnpm intl:build && tsc -b && vite build",
    "build:source": "ANALYZE=true pnpm run build",
    "build:sourcemap": "SOURCEMAP=true pnpm run build",
    "clean": "node -e \"fs.rmSync('dist', {force: true, recursive: true})\"",
    "dev": "vite",
    "intl:build": "pnpm intl:extract",
    "intl:extract": "lingui extract --clean && pnpm run script:sync-translations",
    "jscpd": "jscpd",
    "knip": "knip",
    "lint": "biome check --write . && pnpm lint:deps",
    "lint:ci": "biome ci . && pnpm lint:deps",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:deps": "depcruise --config .dependency-cruiser.mjs src",
    "prepare": "husky",
    "preview": "vite preview",
    "script:check-docs": "node scripts/check-docs.mjs",
    "script:sync-translations": "node scripts/sync-en-translations.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "type": "module",
  "version": "0.1.0"
}
