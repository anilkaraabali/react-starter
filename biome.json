{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "linter": {
      "enabled": false
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/src/assets",
      "!**/*.gen.ts",
      "!**/*.gen.js",
      "!public/mockServiceWorker.js",
      "!.heroui-docs",
      "!.claude",
      "!.agents",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "enabled": true,
    "expand": "auto",
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "useEditorconfig": true
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "attributePosition": "auto",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/api/**",
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/lib/**",
        "src/stores/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features", "@/features/**"],
                    "message": "Shared code must not import features. Move the dependency into the shared layer or compose it in src/app."
                  },
                  {
                    "group": ["@/app", "@/app/**", "@/main"],
                    "message": "Must not import the app layer (src/app, src/main.tsx). Bulletproof flow: shared → features → app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**", "@/main"],
                    "message": "Must not import the app layer (src/app, src/main.tsx). Bulletproof flow: shared → features → app."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "includes": ["**/src/features/**"],
      "path": "./plugins/no-cross-feature.grit"
    },
    {
      "includes": ["**/src/features/**"],
      "path": "./plugins/no-relative-imports-in-features.grit"
    },
    {
      "path": "./plugins/no-test-suffix.grit"
    },
    "./plugins/no-lingui-format-helpers.grit",
    "./plugins/no-runtime-use-lingui.grit",
    "./plugins/no-implicit-locale-format.grit",
    "./plugins/no-module-level-t.grit"
  ],
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
